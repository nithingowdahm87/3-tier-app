# DEV environment — low-cost, single AZ. Copy to terraform.tfvars.
project_name                  = "myapp"
primary_region                = "us-east-1"
secondary_region              = "us-west-2"
aws_account_id                = "123456789012"
primary_vpc_cidr              = "10.10.0.0/16"
secondary_vpc_cidr            = "10.11.0.0/16"
domain_name                   = "dev.example.com"
hosted_zone_id                = "Z_DEV_HOSTEDZONE"
bastion_allowed_cidr          = "YOUR_IP/32"
alert_email                   = "dev-team@example.com"
cloudtrail_bucket_name        = "myapp-dev-cloudtrail-ACCOUNTID"
config_bucket_name            = "myapp-dev-config-ACCOUNTID"
logs_bucket_name              = "myapp-dev-logs-ACCOUNTID"
static_assets_bucket_name     = "myapp-dev-static-ACCOUNTID"
cloudfront_acm_certificate_arn = ""
redis_auth_token              = "REPLACE_WITH_STRONG_RANDOM_TOKEN"
db_name                       = "appdb"
db_username                   = "admin"
