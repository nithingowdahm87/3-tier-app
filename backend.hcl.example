# Partial backend configuration — fill in your real values and run:
#   terraform init -backend-config=backend.hcl
#
# Copy this file: cp backend.hcl.example backend.hcl
# backend.hcl is in .gitignore — NEVER commit it with real values.

bucket         = "REPLACE_WITH_YOUR_STATE_BUCKET"
region         = "us-east-1"
dynamodb_table = "REPLACE_WITH_YOUR_LOCK_TABLE"
encrypt        = true
